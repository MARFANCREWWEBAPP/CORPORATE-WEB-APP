# Railway asigna PORT automáticamente. No es necesario configurarlo.
NODE_ENV=production

# Protección adicional para que la URL de pruebas no quede abierta al público.
# Usa valores distintos a las credenciales internas de la demo.
SITE_ACCESS_USER=marquee-review
SITE_ACCESS_PASSWORD=cambia-esta-clave-por-una-larga-y-unica
