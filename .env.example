# Configurar estas variables en el servicio; este archivo no se carga automáticamente.
NODE_ENV=production
DEMO_MODE=0
APP_ORIGIN=https://eventos.marquee.es
CANONICAL_HOST_REDIRECT=1
# Debe coincidir con la ruta del volumen persistente.
DATA_DIR=/data
# Secreto de 32 bytes en base64, guardado fuera del repositorio.
PORTAL_SECRET_KEY=

# Copias externas cifradas. Conservar también la clave fuera del servidor.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_URL_STYLE=virtual-host
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=

# Destino adicional IONOS HiDrive. Mantiene las copias externas anteriores.
# URL de una carpeta privada concreta dentro de tu cuenta WebDAV.
# La carpeta padre debe existir. Credenciales solo en los secretos del servicio.
BACKUP_HIDRIVE_URL=
BACKUP_HIDRIVE_USER=
BACKUP_HIDRIVE_PASSWORD=

# DEMO_MODE=1 solo para un almacén de demostración independiente.
# El portal privado no se inicializa con cuentas o contraseñas de ejemplo.
# No introducir la contraseña del administrador en este archivo.
